# Copy to .env and fill in values. Do NOT commit .env.

# Django
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,wangari.site,www.wangari.site
SITE_URL=https://wangari.site

# Email (RECOMMENDED: transactional provider + verified domain to avoid spam/bounces)
# 1) Verify your domain (e.g. wangari.site) in Resend/SendGrid/Mailgun/Postmark/SES
# 2) Add SPF, DKIM, DMARC DNS records from the provider
# 3) Send from that verified address
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example-provider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=30
EMAIL_HOST_USER=your-smtp-user-or-apikey
EMAIL_HOST_PASSWORD=your-smtp-password-or-apikey
DEFAULT_FROM_EMAIL=invites@wangari.site
DEFAULT_FROM_NAME=Wangari's Birthday
REPLY_TO_EMAIL=you@example.com

# Database (PostgreSQL recommended for production)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# Vercel Blob (media uploads)
BLOB_READ_WRITE_TOKEN=
